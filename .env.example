# Generate distinct random secrets (hexadecimal avoids URL escaping in DATABASE_URI).
SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Reuse the existing MinIO service and bucket. localhost inside a container
# refers to that container; use host.docker.internal for a host-published MinIO.
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=tablon-cultural-uploads
MINIO_SECURE=false
SITE_URL=https://cultura.example.org
TRUSTED_PROXY_COUNT=2
FORCE_HTTPS=true
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=cultura@example.org
ADMIN_NOTIFICATION_EMAIL=cultura@example.org
IMAP_SERVER=imap.example.org
IMAP_PORT=993

# Direct local Flask execution; Docker Compose supplies its internal database URI.
FLASK_APP=wsgi:app
FLASK_CONFIG=development
DATABASE_URI=mysql+pymysql://tablon:YOUR_PASSWORD@localhost:3306/tablon?charset=utf8mb4
